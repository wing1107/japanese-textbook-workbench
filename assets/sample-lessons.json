    {
     "pattern": "名詞 は 名詞 です",
     "name": "判断句：A 是 B",
     "desc": "「は」提示主题，「です」表示断定。否定用「では ありません」。",
     "examples": [
      ["わたしは 学生です。", "我是学生。"],
